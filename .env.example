# Copy to .env (git-ignored). Supabase Dashboard > Connect > Session pooler connection string.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Public values used by build.py (anon key is safe to expose; RLS blocks raw tables).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
